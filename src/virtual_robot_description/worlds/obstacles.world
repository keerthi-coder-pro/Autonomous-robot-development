<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="obstacle_arena">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-7.5 -6.5 5.0 0 0.55 0.75</pose>
      </camera>
    </gui>

    <!-- Arena walls. The robot starts in the south-west and must turn around boxes. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.6 0.16 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.6 0.16 0.7</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.6 0.16 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.6 0.16 0.7</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.7 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 9.6 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 9.6 0.7</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.7 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 9.6 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.16 9.6 0.7</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_ahead">
      <static>true</static>
      <pose>-1.15 -0.15 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.55 0.55 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.55 0.8</size></box></geometry>
          <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_mid">
      <static>true</static>
      <pose>0.6 1.1 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_right_wall">
      <static>true</static>
      <pose>1.7 -0.9 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 1.4 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.45 1.4 0.8</size></box></geometry>
          <material><ambient>0.75 0.15 0.2 1</ambient><diffuse>0.75 0.15 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_north">
      <static>true</static>
      <pose>-0.8 2.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.32</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.15 0.55 0.35 1</ambient><diffuse>0.15 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_south">
      <static>true</static>
      <pose>1.1 -2.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.15 0.45 0.7 1</ambient><diffuse>0.15 0.45 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_east">
      <static>true</static>
      <pose>3.0 1.4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.45 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.45 0.6</size></box></geometry>
          <material><ambient>0.55 0.2 0.7 1</ambient><diffuse>0.55 0.2 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_west">
      <static>true</static>
      <pose>-2.6 -1.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.5 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.5 0.7</size></box></geometry>
          <material><ambient>0.8 0.65 0.15 1</ambient><diffuse>0.8 0.65 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
