  <version>0.1.0</version>
  <description>URDF model and Gazebo world for the virtual autonomous robot.</description>
  <maintainer email="dev@example.com">Virtual Robot Project</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
